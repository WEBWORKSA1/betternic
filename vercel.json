{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no install step'",
  "buildCommand": "python3 scripts/deploy_build.py",
  "outputDirectory": "public",
  "crons": [
    { "path": "/api/daily-refresh", "schedule": "17 6 * * *" }
  ],
  "redirects": [
    { "source": "/browse.html", "destination": "/marketplace.html", "permanent": true },
    { "source": "/lander.html", "destination": "/domain.html", "permanent": true },
    { "source": "/checkout.html", "destination": "/domain.html", "permanent": true },
    { "source": "/listing-new.html", "destination": "/sell.html", "permanent": true },
    { "source": "/dashboard.html", "destination": "/tools/portfolio-tracker.html", "permanent": true },
    { "source": "/login.html", "destination": "/sell.html", "permanent": true },
    { "source": "/lease.html", "destination": "/tools/lease-to-own-calculator.html", "permanent": true },
    { "source": "/categories.html", "destination": "/marketplace.html", "permanent": true },
    { "source": "/auctions", "destination": "/tools/domain-auctions.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
